/* SPINNER */
.loader { display:block; position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); width:5em; height:5em; z-index:9999; }
.loader:before { content:url(../images/loader2.svg); width:2em; height:2em; position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); animation:_load 1s linear infinite; }
.loader:after { content:url(../images/loader2.svg); width:2em; height:2em; position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); animation:_load1 1s linear infinite; }
@keyframes _load {
    0%{transform:translate(-50%,-50%) rotate(0) scale(1); }
    50%{transform:translate(-50%,-50%) rotate(180deg) scale(.8); }
    100%{transform:translate(-50%,-50%) rotate(360deg) scale(1); }
}
@keyframes _load1 {
    0%{transform:translate(-50%,-50%) rotate(-180deg) scale(1); }
    50%{transform:translate(-50%,-50%) rotate(0deg) scale(.88); }
    100%{transform:translate(-50%,-50%) rotate(180deg) scale(1); }
}





